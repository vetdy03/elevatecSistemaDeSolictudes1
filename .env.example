# ---------------------------------------------------------------
# FinControl — copiar a .env y completar antes de "docker compose up"
# ---------------------------------------------------------------

# Puerto del NAS/PC donde se publica la app (http://IP:APP_PORT)
APP_PORT=8080
# URL con la que los usuarios abren la app (IP del NAS o dominio del proxy inverso)
APP_URL=http://192.168.1.50:8080

# Generar con:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

APP_ENV=production
APP_DEBUG=false

# Base de datos MySQL
DB_DATABASE=fincontrol
DB_USERNAME=fincontrol
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root

# Contraseña de los usuarios iniciales que crea el seeder
SEED_USER_PASSWORD=FinControl2026!

# Ejecutar "php artisan migrate" al iniciar el contenedor app
RUN_MIGRATIONS=true

# true solo si se accede por HTTPS (p. ej. detrás del proxy inverso de Synology con certificado)
SESSION_SECURE_COOKIE=false

# Carpeta del host donde se guardan los datos persistentes (MySQL y archivos)
# En Synology, p. ej.: /volume1/docker/fincontrol/data
DATA_PATH=./data

TZ=America/La_Paz
